DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|tests|docs|\.git)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "(?i)^(README\.md|INSTALACION\.txt|LICENCIAS\.txt|\.(?:git.*|env.*|user\.ini)|.*\.(?:sql|zip|bak|log|sqlite|dump))$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
